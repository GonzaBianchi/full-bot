# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Registra los comandos solo en este servidor (inmediato). Vacío = registro global.
DEV_GUILD_ID=

# ── Base de datos ─────────────────────────────────────────────────────────────
# Obligatorio: también es el store de sesiones.
MONGODB_URI=

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
# Obligatorio: origen exacto del frontend (CORS con credenciales).
FRONTEND_URL=http://localhost:5173
# Obligatorio, mínimo 32 caracteres.
SESSION_SECRET=
NODE_ENV=development
# Poner a 1 detrás de un proxy inverso fuera de producción.
TRUST_PROXY=

# ── Opcionales ────────────────────────────────────────────────────────────────
# Nivel del logger: debug | info | warn | error (por defecto: debug en dev, info en prod)
LOG_LEVEL=
# Se muestra en /botinfo; si está vacío, no aparece el campo.
BOT_DEVELOPER_ID=
# Permisos del enlace de invitación de /botinfo. Por defecto los mínimos que
# necesita el bot (gestionar roles, leer/enviar mensajes, adjuntar, reaccionar).
BOT_INVITE_PERMISSIONS=268823632
